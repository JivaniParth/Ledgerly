<?xml version="1.0" encoding="utf-8"?>
<!--
    Ledgerly — App Icon Foreground Layer
    Canvas: 108×108 dp (Android adaptive icon standard)
    Safe zone: center 72dp (18dp margin on each side)

    Symbol: A geometric open ledger book
      - Vertical spine bar on the left
      - Three horizontal ledger rows on the right, each slightly shorter
        than the one above (ascending staircase = financial growth)
      - A warm gold accent bar at the bottom row
    Design: Flat, minimal, no drop shadows — professional fintech aesthetic
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        ═══════════════════════════════════════════
        BOOK SPINE — vertical bar, left anchor
        Positioned at x=28, center of safe zone left edge
        Width: 6dp, Height: 52dp, rounded caps via rect corners
        ═══════════════════════════════════════════
    -->
    <path
        android:fillColor="#1E2A5E"
        android:pathData="
            M 31,28
            A 3,3 0 0 1 34,28
            L 34,80
            A 3,3 0 0 1 31,80
            Z" />

    <!--
        ═══════════════════════════════════════════
        LEDGER ROW 1 — Top row (longest)
        Represents the first line item in a ledger
        x: 39 → 76, y: 33 → 38  (5dp tall)
        ═══════════════════════════════════════════
    -->
    <path
        android:fillColor="#1E2A5E"
        android:pathData="
            M 39,33
            A 2.5,2.5 0 0 1 41.5,33
            L 73.5,33
            A 2.5,2.5 0 0 1 76,33
            L 76,38
            A 2.5,2.5 0 0 1 73.5,38
            L 41.5,38
            A 2.5,2.5 0 0 1 39,38
            Z" />

    <!--
        ═══════════════════════════════════════════
        LEDGER ROW 2 — Middle row (medium, 8dp shorter)
        Staircase step: shorter than row 1
        x: 39 → 68, y: 47 → 52
        ═══════════════════════════════════════════
    -->
    <path
        android:fillColor="#1E2A5E"
        android:pathData="
            M 39,47
            A 2.5,2.5 0 0 1 41.5,47
            L 65.5,47
            A 2.5,2.5 0 0 1 68,47
            L 68,52
            A 2.5,2.5 0 0 1 65.5,52
            L 41.5,52
            A 2.5,2.5 0 0 1 39,52
            Z" />

    <!--
        ═══════════════════════════════════════════
        LEDGER ROW 3 — Bottom row (shortest, gold accent)
        Staircase step: shortest of three
        x: 39 → 60, y: 61 → 66
        Color: warm gold — the accent/highlight
        ═══════════════════════════════════════════
    -->
    <path
        android:fillColor="#D4A843"
        android:pathData="
            M 39,61
            A 2.5,2.5 0 0 1 41.5,61
            L 57.5,61
            A 2.5,2.5 0 0 1 60,61
            L 60,66
            A 2.5,2.5 0 0 1 57.5,66
            L 41.5,66
            A 2.5,2.5 0 0 1 39,66
            Z" />

    <!--
        ═══════════════════════════════════════════
        DIVIDER LINE — Horizontal rule below spine cap
        Connects the spine to the row area visually
        Subtle, thin — 1dp height
        ═══════════════════════════════════════════
    -->
    <path
        android:fillColor="#1E2A5E"
        android:fillAlpha="0.18"
        android:pathData="M 34,72 L 76,72 L 76,73.5 L 34,73.5 Z" />

    <!--
        ═══════════════════════════════════════════
        SPINE CAP TOP — decorative top cap on spine
        A small rounded rectangle sitting above row 1
        Adds a subtle "book cover" feel
        ═══════════════════════════════════════════
    -->
    <path
        android:fillColor="#1E2A5E"
        android:pathData="
            M 28,26
            A 3,3 0 0 1 36,26
            L 36,30
            L 28,30
            Z" />

    <!--
        ═══════════════════════════════════════════
        SPINE CAP BOTTOM — decorative bottom cap
        ═══════════════════════════════════════════
    -->
    <path
        android:fillColor="#1E2A5E"
        android:pathData="
            M 28,78
            L 36,78
            L 36,82
            A 3,3 0 0 1 28,82
            Z" />

</vector>
