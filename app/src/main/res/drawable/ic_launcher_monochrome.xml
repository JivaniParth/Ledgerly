<?xml version="1.0" encoding="utf-8"?>
<!--
    Ledgerly — Monochrome Foreground Layer (Android 13+ Themed Icons)
    Single-color white — Android Material You will tint this automatically
    with the user's wallpaper accent color via the <monochrome> tag.
    Same geometry, all paths use pure white.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- BOOK SPINE -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 31,28
            A 3,3 0 0 1 34,28
            L 34,80
            A 3,3 0 0 1 31,80
            Z" />

    <!-- LEDGER ROW 1 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 39,33
            A 2.5,2.5 0 0 1 41.5,33
            L 73.5,33
            A 2.5,2.5 0 0 1 76,33
            L 76,38
            A 2.5,2.5 0 0 1 73.5,38
            L 41.5,38
            A 2.5,2.5 0 0 1 39,38
            Z" />

    <!-- LEDGER ROW 2 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 39,47
            A 2.5,2.5 0 0 1 41.5,47
            L 65.5,47
            A 2.5,2.5 0 0 1 68,47
            L 68,52
            A 2.5,2.5 0 0 1 65.5,52
            L 41.5,52
            A 2.5,2.5 0 0 1 39,52
            Z" />

    <!-- LEDGER ROW 3 (same white for monochrome) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 39,61
            A 2.5,2.5 0 0 1 41.5,61
            L 57.5,61
            A 2.5,2.5 0 0 1 60,61
            L 60,66
            A 2.5,2.5 0 0 1 57.5,66
            L 41.5,66
            A 2.5,2.5 0 0 1 39,66
            Z" />

    <!-- DIVIDER -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.4"
        android:pathData="M 34,72 L 76,72 L 76,73.5 L 34,73.5 Z" />

    <!-- SPINE CAP TOP -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 28,26
            A 3,3 0 0 1 36,26
            L 36,30
            L 28,30
            Z" />

    <!-- SPINE CAP BOTTOM -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 28,78
            L 36,78
            L 36,82
            A 3,3 0 0 1 28,82
            Z" />

</vector>
